<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- libwebrtc's network monitor and the MQTT reconnection register ConnectivityManager callbacks (normal permission, no prompt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Remote control over MQTT: foreground service keeping the broker connection alive 24/7. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Its notification; requested at runtime on Android 13+ by the UI. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Over-the-air updates: the app hands the downloaded APK to PackageInstaller. The user grants
      "install unknown apps" once in Settings (canRequestPackageInstalls); without Device Owner the
      system still shows its own confirmation dialog on every install. See docs/RELEASE-OTA.md.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".HaKioskApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HAKiosk">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HAKiosk"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The install kills the app's process, so after an over-the-air update nothing of ours is
          running: this starts the background work again. It cannot bring the dashboard back to the
          front (background activity starts are blocked on Android 10+); see the receiver's KDoc.
        -->
        <receiver
            android:name=".data.update.android.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".data.device.service.RemoteControlService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent MQTT connection to the user's self-hosted Home Assistant broker so this wall-mounted kiosk tablet can be controlled remotely (screen, dashboard view, cameras) 24/7." />
        </service>
    </application>

</manifest>