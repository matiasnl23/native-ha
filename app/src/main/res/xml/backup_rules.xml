<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower (API < 31).
   See https://developer.android.com/guide/topics/data/autobackup
   The HA server config is excluded: its token is encrypted with a device-bound Keystore key and
   can't be decrypted after a restore on another device.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/ha_server_config.preferences_pb" />
</full-backup-content>
