<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+ (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   The HA server config is excluded: its token is encrypted with a device-bound Keystore key and
   can't be decrypted after a restore or transfer to another device. The MQTT broker config is
   excluded for the same reason (encrypted password) and because its device id must be unique per install.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/ha_server_config.preferences_pb" />
        <exclude domain="file" path="datastore/mqtt_config.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/ha_server_config.preferences_pb" />
        <exclude domain="file" path="datastore/mqtt_config.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
